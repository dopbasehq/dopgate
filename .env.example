# Copy to .env and fill in. docker compose reads it.

# PostgreSQL password for the bundled database.
POSTGRES_PASSWORD=change-me

# The address your app and users reach dopgate on. It is also the issuer of
# every access token, so set it before you go live.
DOPGATE_PUBLIC_URL=http://localhost:8850

# Browser origins allowed to call dopgate (your app's frontend), comma-separated.
DOPGATE_ALLOWED_ORIGINS=http://localhost:3000

# Your backend sends this as a bearer token to use the admin API.
# Generate with: openssl rand -base64 32
DOPGATE_SERVICE_KEY=

# On first start, create the root account for this email and print a
# generated password once. Later starts ignore it.
DOPGATE_ROOT_EMAIL=admin@example.com

# Outgoing email. Without a host, emails (and their codes) go to the log.
DOPGATE_SMTP_HOST=
DOPGATE_SMTP_PORT=587
DOPGATE_SMTP_SECURITY=starttls
DOPGATE_SMTP_USERNAME=
DOPGATE_SMTP_PASSWORD=
DOPGATE_SMTP_FROM_EMAIL=no-reply@example.com
DOPGATE_SMTP_FROM_NAME=My App

{
  "name": "dopgate",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "bun ./scripts/dev.ts",
    "dev:app": "cargo run --manifest-path app/Cargo.toml -- serve --data-dir .dev-data",
    "dev:docs": "vitepress dev docs",
    "build": "bun run build:app && bun run build:docs",
    "build:app": "cargo build --manifest-path app/Cargo.toml --release",
    "build:docs": "bun run clean:docs && vitepress build docs",
    "preview:docs": "vitepress preview docs",
    "test": "bun run test:app",
    "test:app": "cargo test --manifest-path app/Cargo.toml --all-targets",
    "lint": "bun run lint:app",
    "lint:app": "cargo clippy --manifest-path app/Cargo.toml --all-targets -- -D warnings",
    "format:app": "cargo fmt --manifest-path app/Cargo.toml",
    "format:app:check": "cargo fmt --manifest-path app/Cargo.toml -- --check",
    "clean": "bun run clean:app && bun run clean:docs",
    "clean:app": "cargo clean --manifest-path app/Cargo.toml",
    "clean:docs": "rm -rf ./docs/.vitepress/dist/ ./docs/.vitepress/cache/"
  },
  "devDependencies": {
    "fastdom": "^1.0.12",
    "mermaid": "^11",
    "vitepress": "^2.0.0-alpha.19",
    "vitepress-mermaid-viewer": "^0.4.0"
  }
}
